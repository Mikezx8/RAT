// icon.rc - Resource file for adding icon to executable

// Define the icon resource
// ID 1 is the main application icon
1 ICON "icon.ico"

// Optional: Version information
1 VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x40004L
FILETYPE        0x1L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Microsoft Corporation"
            VALUE "FileDescription", "Microsoft Edge Update Service"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "MicrosoftEdgeUpdate"
            VALUE "LegalCopyright", "Copyright (C) Microsoft Corporation. All rights reserved."
            VALUE "OriginalFilename", "MicrosoftEdgeUpdate.exe"
            VALUE "ProductName", "Microsoft Edge"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
